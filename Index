<style>
:root{--bg:#f4f5f9;--card:#fff;--ink:#111827;--mut:#6b7280;--line:#e5e7eb;--acc:#f97316;--ok:#16a34a;--warn:#d97706;--bad:#dc2626;--side:#111827}
*{box-sizing:border-box}body{margin:0;font:14px Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink)}
#side{width:230px;background:var(--side);padding:18px 12px;position:fixed;inset:0 auto 0 0;overflow:auto;z-index:20;transition:.2s}
