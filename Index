.stat.ok{border-color:var(--ok)}.stat.bad{border-color:var(--bad)}.stat.warn{border-color:var(--warn)}
.stat small{color:var(--mut);font-weight:500}.stat div{font-size:22px;font-weight:700;margin-top:4px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px}
.ch{height:260px;position:relative}
.bar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.gap{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end}.end{justify-content:flex-end;margin-top:16px}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:11px;text-transform:uppercase;color:var(--mut);padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}tr:hover td{background:#fafafa}
.mut{color:var(--mut)}small{color:var(--mut);display:block}
.btn{border:0;background:var(--acc);color:#fff;padding:9px 15px;border-radius:8px;cursor:pointer;font:inherit;font-weight:600}
.btn.sm{padding:4px 9px;font-size:12px}.btn.g{background:#eef0f4;color:var(--ink)}.btn.r{background:#fee2e2;color:var(--bad)}.btn.w{background:#22c55e}.btn.k{background:var(--ink)}
.b{padding:2px 9px;border-radius:99px;font-size:12px;font-weight:600;display:inline-block}
.b.ok{background:#dcfce7;color:#166534}.b.warn{background:#fef3c7;color:#92400e}.b.bad{background:#fee2e2;color:#991b1b}.b.mu{background:#e5e7eb;color:#374151}.b.in{background:#dbeafe;color:#1e40af}
label{font-size:12px;font-weight:600;color:var(--mut);display:block;margin-bottom:4px}
input,select,textarea{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:8px;font:inherit;background:#fff;color:var(--ink)}
input[readonly]{background:#f3f4f6}.gap input,.gap select{width:auto;min-width:150px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.full{grid-column:1/-1}
.ov{position:fixed;inset:0;background:#0008;overflow:auto;padding:28px 12px;z-index:50;display:flex;justify-content:center;align-items:flex-start}
.md{background:#fff;border-radius:14px;width:100%;max-width:720px;padding:20px}.md.wide{max-width:980px}.md h3{margin-top:0}
.li{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}.li:last-child{border:0}
.av{width:48px;height:48px;border-radius:50%;background:var(--acc);color:#fff;display:grid;place-items:center;font-weight:700;overflow:hidden}.av img{width:100%;height:100%;object-fit:cover}
#toast{position:fixed;right:16px;bottom:16px;z-index:99}#toast div{background:var(--ink);color:#fff;padding:10px 16px;border-radius:10px;margin-top:8px}#toast .e{background:var(--bad)}
#loader{display:none;position:fixed;inset:0;background:#fff8;z-index:90;align-items:center;justify-content:center}
#loader i{width:38px;height:38px;border:4px solid #ddd;border-top-color:var(--acc);border-radius:50%;animation:s .7s linear infinite}@keyframes s{to{transform:rotate(360deg)}}
#print{display:none}
@media print{#app,#modalRoot,#toast,#loader{display:none!important}#print{display:block}}
@media(max-width:900px){#side{transform:translateX(-100%)}#side.open{transform:none}main{margin-left:0;padding:12px}#burger{display:block}}
