function eList(){const f=$('#ef').value,t=$('#et').value,c=$('#ec').value,L=DB.expenses.filter(e=>(!f||e.Date>=f)&&(!t||e.Date<=t)&&(!c||e.Category===c)).sort((a,b)=>a.Date<b.Date?1:-1);
  $('#esum').textContent='Total: '+money(L.reduce((a,e)=>a+n(e.Amount),0))+' ('+L.length+' entries)';
  $('#etb').innerHTML=tbl([['ID',e=>e.ExpenseID],['Date',e=>e.Date],['Category',e=>esc(e.Category)],['Description',e=>esc(e.Description)],['Amount',e=>`<b>${money(e.Amount)}</b>`],['Mode',e=>e.Mode],['Notes',e=>esc(e.Notes)],['',e=>`<span class="gap"><button class="btn sm g" onclick="expForm('${e.ExpenseID}')">Edit</button><button class="btn sm r" onclick="delExp('${e.ExpenseID}')">Delete</button></span>`]],L);}
function expForm(id){const e=id?DB.expenses.find(x=>x.ExpenseID===id):{Date:DB.today,Category:'Rent',Mode:'Cash'};
  MF=[{k:'Date',l:'Expense Date',t:'date',r:1},{k:'Category',l:'Category',t:'select',o:CATS},{k:'Description',l:'Description'},{k:'Amount',l:'Amount',t:'number',r:1},{k:'Mode',l:'Payment Mode',t:'select',o:MODES},{k:'Notes',l:'Notes',t:'textarea',full:1}];
  modal(`<h3>${id?'Edit':'Add'} Expense</h3><div class="grid">${MF.map(f=>fld(f,e)).join('')}</div><div class="gap end"><button class="btn g" onclick="closeM()">Cancel</button><button class="btn" onclick="saveExp('${id||''}')">Save</button></div>`);}
async function saveExp(id){const o=val(MF);if(!o)return;if(id)o.ExpenseID=id;await call('saveExpense',{e:o});closeM();V[page]();toast('Expense saved');}
function delExp(id){ask('Delete this expense?',async()=>{await call('deleteExpense',{id});V[page]();});}

/* ===== reports ===== */
function vRep(){const f=DB.today.slice(0,8)+'01';$('#view').innerHTML=`<div class="bar"><h2>Reports & Analytics</h2></div><div class="card"><div class="gap"><div><label>Report</label><select id="rt">${REP.map(r=>`<option value="${r[0]}">${r[1]}</option>`).join('')}</select></div><div><label>From</label><input type="date" id="rf" value="${f}"></div><div><label>To</label><input type="date" id="rto" value="${DB.today}"></div><button class="btn" onclick="runRep()">Run Report</button><button class="btn g" onclick="csv()">⬇ Export CSV</button><button class="btn g" onclick="printRep()">🖨 Print</button></div><p class="mut" style="margin:10px 0 0">Profit = payments actually received − recorded expenses. Pending fees are never counted as revenue.</p></div><div class="card tw" id="rout"><span class="mut">Choose a report and press Run.</span></div>`;}
async function runRep(){const t=$('#rt').value,r=await call('report',{type:t,from:$('#rf').value,to:$('#rto').value});RPT={cols:r.cols,rows:r.rows,name:t+'_'+$('#rf').value+'_'+$('#rto').value};
  $('#rout').innerHTML=`<h3>${REP.find(x=>x[0]===t)[1]}</h3>`+tbl(r.cols.map((c,i)=>[c,x=>{const v=x[i];return typeof v==='number'&&/Amount|Income|Expenses|Profit|Received|Total$|Payable|Paid|Outstanding|Pending/.test(c)&&!/Days|Entries|Payments/.test(c)?money(v):esc(v);}]),r.rows);}
function csv(){if(!RPT.rows.length)return toast('Run a report first',1);const s=[RPT.cols].concat(RPT.rows).map(r=>r.map(c=>'"'+String(c==null?'':c).replace(/"/g,'""')+'"').join(',')).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+s],{type:'text/csv'}));a.download=RPT.name+'.csv';a.click();}
function printRep(){if(!RPT.rows.length)return toast('Run a report first',1);doPrint(`<div style="font-family:Arial"><h2>${GYM}</h2>${$('#rout').innerHTML.replace(/<th>/g,'<th style="text-align:left;border-bottom:1px solid #000;padding:4px">').replace(/<td>/g,'<td style="padding:4px;border-bottom:1px solid #ddd">')}</div>`);}

/* ===== init ===== */
$('#nav').innerHTML=NAV.map(x=>`<a data-p="${x[0]}" onclick="go('${x[0]}')"><span>${x[2]}</span>${x[1]}</a>`).join('');
$('#dt').textContent=new Date().toDateString();
function startApp(first){call('bootstrap').then(()=>go(first||'dashboard')).catch(()=>{$('#view').innerHTML='<div class="card">Could not load data. Run setup() once in the Apps Script editor and redeploy.</div>';});}
</script>
<script>
/* ===== SETTINGS + LOGIN + ACCESS CONTROL MODULE (added) ===== */
(function(){
var TOK='',ME=null,SET=null,MEMT='',USERS=[],TAB='profile',LOGO;
var SK='gm_tok',RANK={none:0,view:1,edit:2};
var ML={dashboard:'Dashboard',members:'Members',plans:'Membership Plans',payments:'Payments',attendance:'Attendance',renewals:'Renewals',expenses:'Expenses',reports:'Reports',settings:'Settings'};
function gid(i){return document.getElementById(i);}
var store={
  get:function(){var v='';try{v=localStorage.getItem(SK)||sessionStorage.getItem(SK)||'';}catch(e){}return v||MEMT;},
  set:function(t,rem){MEMT=t;try{localStorage.removeItem(SK);sessionStorage.removeItem(SK);(rem?localStorage:sessionStorage).setItem(SK,t);}catch(e){}},
  clear:function(){MEMT='';try{localStorage.removeItem(SK);sessionStorage.removeItem(SK);}catch(e){}}
};
function raw(a,p){return new Promise(function(ok,no){google.script.run.withSuccessHandler(function(r){try{var j=JSON.parse(r);j.ok?ok(j.data):no(new Error(j.error));}catch(e){no(e);}}).withFailureHandler(function(e){no(new Error((e&&e.message)||String(e)));}).api(a,Object.assign({},p||{},{_t:TOK}));});}
function can(mod,lvl){if(!ME)return false;if(ME.Role==='Super Admin')return true;var r=((SET&&SET.perms||{})[ME.Role]||{})[mod]||'none';return RANK[r]>=RANK[lvl||'view'];}
function isSA(){return !!ME&&ME.Role==='Super Admin';}

/* ---- wrap existing functions (existing code is NOT edited) ---- */
var _call=window.call,_go=window.go;
window.call=async function(a,p,o){try{return await _call(a,Object.assign({},p||{},{_t:TOK}),o);}catch(e){if(e&&/Session expired/i.test(e.message||''))setTimeout(logout,50);throw e;}};
window.go=function(p){if(!can(p,'view')){toast('You do not have access to '+(ML[p]||p),1);return;}_go(p);};
window.rcptNo=function(id){var pre=SET&&SET.financial&&SET.financial.ReceiptPrefix,m=String(id).match(/(\d+)$/);return pre&&m?pre+m[1]:id;};

/* ---- login screen ---- */
function shell(h){var el=gid('gmLogin');if(!el){el=document.createElement('div');el.id='gmLogin';document.body.appendChild(el);}el.innerHTML=h;return el;}
function splash(){shell('<div class="gl-spin"></div>');}
function showLogin(info){
  var g=(info&&info.gym)||{},setup=!!(info&&info.needsSetup),nm=esc(g.GymName||GYM);
  shell('<div class="gl-wrap"><div class="gl-hero"><div class="gl-logo">'+(g.Logo?'<img src="'+esc(g.Logo)+'" alt="">':'🏋️')+'</div><h1>'+nm+'</h1><p>Members, fees, attendance and reports – everything your gym needs, in one secure place.</p><ul><li>📊 Live dashboard &amp; reports</li><li>💳 Fees, receipts &amp; renewals</li><li>🔐 Role-based secure access</li></ul></div>'+
  '<form class="gl-card" id="glForm" autocomplete="on"><h2>'+(setup?'Create Super Admin':'Welcome back 👋')+'</h2><p class="gl-sub">'+(setup?'First-time setup – create the owner account.':'Sign in to continue to your dashboard')+'</p>'+
  (setup?'<label>Full Name</label><input id="gl_name" placeholder="Your name" autocomplete="name">':'')+
  '<label>Username</label><input id="gl_u" placeholder="username" autocomplete="username" autocapitalize="none" spellcheck="false">'+
  '<label>Password</label><div class="gl-pw"><input id="gl_p" type="password" placeholder="••••••••" autocomplete="'+(setup?'new-password':'current-password')+'"><button type="button" id="gl_eye" title="Show / hide">👁</button></div>'+
  (setup?'<label>Confirm Password</label><input id="gl_p2" type="password" placeholder="Repeat password" autocomplete="new-password">':'<label class="gl-rem"><input type="checkbox" id="gl_rem" checked> Keep me signed in on this device</label>')+
  '<div class="gl-err" id="gl_err"></div><button class="gl-btn" id="gl_go">'+(setup?'Create account &amp; continue':'Sign in')+'</button><div class="gl-foot">© '+new Date().getFullYear()+' '+nm+'</div></form></div>');
  var err=gid('gl_err'),btn=gid('gl_go'),label=setup?'Create account & continue':'Sign in';
  gid('gl_eye').onclick=function(){var i=gid('gl_p');i.type=i.type==='password'?'text':'password';};
  gid('glForm').onsubmit=async function(e){e.preventDefault();err.textContent='';
    var u=gid('gl_u').value.trim(),pw=gid('gl_p').value,pl={username:u,password:pw};
    if(!u||!pw){err.textContent='Please enter username and password';return;}
    if(setup){var fn=gid('gl_name').value.trim();if(!fn){err.textContent='Please enter your full name';return;}if(pw.length<6){err.textContent='Password must be at least 6 characters';return;}if(pw!==gid('gl_p2').value){err.textContent='Passwords do not match';return;}pl.name=fn;}
    btn.disabled=true;btn.textContent=setup?'Creating…':'Signing in…';
    try{var r=await raw(setup?'setupAdmin':'login',pl);TOK=r.token;store.set(TOK,setup||gid('gl_rem').checked);ME=r.user;await enter();}
    catch(x){err.textContent=x.message||'Login failed';btn.disabled=false;btn.textContent=label;}
  };
  setTimeout(function(){var f=gid(setup?'gl_name':'gl_u');if(f)f.focus();},60);
}
async function enter(){
  SET=await raw('getSettings');
  var el=gid('gmLogin');if(el)el.remove();
  document.body.classList.add('gm-in');
  brand();nav();hdr();
  var fp=['dashboard','members','plans','payments','attendance','renewals','expenses','reports','settings'].find(function(p){return can(p,'view');});
  if(!fp){$('#view').innerHTML='<div class="card">No modules are assigned to your role yet. Please contact the Super Admin.</div>';$('#title').textContent='Access';return;}
  startApp(fp);
}
function logout(){
  var t=TOK;TOK='';ME=null;SET=null;store.clear();
  try{google.script.run.withFailureHandler(function(){}).api('logout',{_t:t});}catch(e){}
  DB={members:[],plans:[],payments:[],expenses:[],history:[],dash:{},today:''};
  closeM();$('#view').innerHTML='';$('#title').textContent='';document.body.classList.remove('gm-in');
  splash();raw('authInfo').then(showLogin).catch(function(){showLogin({gym:{}});});
}
function brand(){GYM=(SET.profile&&SET.profile.GymName)||GYM;document.title=GYM;$('.brand').innerHTML=(SET.logo?'<img class="gm-bl" src="'+esc(SET.logo)+'" alt="">':'🏋️')+' <span>'+esc(GYM)+'</span>';}
function nav(){
  if(!NAV.some(function(x){return x[0]==='settings';}))NAV.push(['settings','Settings','⚙️']);
  $('#nav').innerHTML=NAV.filter(function(x){return can(x[0],'view');}).map(function(x){return '<a data-p="'+x[0]+'" onclick="go(\''+x[0]+'\')"><span>'+x[2]+'</span>'+x[1]+'</a>';}).join('');
  var w=gid('gmWho');if(!w){w=document.createElement('div');w.id='gmWho';$('#side').appendChild(w);}
  var nm=ME.FullName||ME.Username;
  w.innerHTML='<div class="gm-u"><div class="av">'+esc(nm[0].toUpperCase())+'</div><div><b>'+esc(nm)+'</b><small>'+esc(ME.Role)+'</small></div></div><button class="btn g" style="width:100%" onclick="GM.logout()">⎋ Logout</button>';
  document.querySelectorAll('#side a').forEach(function(a){a.classList.toggle('on',a.dataset.p===page);});
}
function hdr(){if(gid('gmLo'))return;var b=document.createElement('button');b.id='gmLo';b.className='btn g sm';b.textContent='⎋ Logout';b.onclick=logout;$('header').appendChild(b);}

/* ---- form helpers ---- */
function F(id,l,v,o){o=o||{};var d=o.dis?' disabled':'',i;
  if(o.sel)i='<select id="'+id+'"'+d+'>'+o.sel.map(function(x){return '<option '+(x===v?'selected':'')+'>'+esc(x)+'</option>';}).join('')+'</select>';
  else if(o.ta)i='<textarea id="'+id+'" rows="2"'+d+'>'+esc(v)+'</textarea>';
  else i='<input id="'+id+'" type="'+(o.t||'text')+'" value="'+esc(v)+'"'+(o.ph?' placeholder="'+esc(o.ph)+'"':'')+d+'>';
  return '<div class="'+(o.full?'full':'')+'"><label>'+l+(o.r?' *':'')+'</label>'+i+(o.hint?'<small>'+o.hint+'</small>':'')+'</div>';}
function gv(id){return gid(id).value.trim();}
var YN=['Yes','No'];

/* ---- Settings page ---- */
V.settings=async function(){SET=await call('getSettings');draw();};
function draw(){
  var T=[['profile','🏢 Gym Profile'],['attendance','✅ Attendance'],['access','🔐 Staff & Permissions'],['financial','💰 Financial'],['account','👤 My Account']];
  $('#view').innerHTML='<div class="gm-tabs">'+T.map(function(t){return '<button class="'+(TAB===t[0]?'on':'')+'" onclick="GM.tab(\''+t[0]+'\')">'+t[1]+'</button>';}).join('')+'</div><div id="gmTab"></div>';
  ({profile:tProfile,attendance:tAtt,access:tAccess,financial:tFin,account:tAcct})[TAB]();
}
function tProfile(){var p=SET.profile,ed=can('settings','edit'),d=!ed;LOGO=undefined;
  $('#gmTab').innerHTML='<div class="card"><h3>🏢 Gym Profile</h3><div class="grid">'+
  F('p_GymName','Gym Name',p.GymName,{r:1,dis:d})+F('p_OwnerName','Owner Name',p.OwnerName,{dis:d})+
  F('p_Mobile','Mobile Number',p.Mobile,{t:'tel',dis:d})+F('p_WhatsApp','WhatsApp Number',p.WhatsApp,{t:'tel',dis:d})+F('p_Email','Email Address',p.Email,{t:'email',dis:d})+
  F('p_Address','Full Address',p.Address,{ta:1,full:1,dis:d})+
  F('p_City','City',p.City,{dis:d})+F('p_State','State',p.State,{dis:d})+F('p_Pin','PIN Code',p.Pin,{dis:d})+
  F('p_GST','GST Number (optional)',p.GST,{dis:d})+F('p_Website','Website (optional)',p.Website,{dis:d})+
  '<div class="full"><label>Gym Logo</label><div class="gap" style="align-items:center"><div class="gm-logo" id="p_prev">'+(SET.logo?'<img src="'+esc(SET.logo)+'">':'🏋️')+'</div><input type="file" accept="image/*" style="max-width:260px" onchange="GM.pickLogo(this)"'+(d?' disabled':'')+'><button class="btn sm r" onclick="GM.rmLogo()"'+(d?' disabled':'')+'>Remove</button></div><small>PNG / JPG – auto-resized. Shown on the login screen and sidebar.</small></div></div>'+
  (ed?'<div class="gap end"><button class="btn" onclick="GM.saveProfile()">Save Profile</button></div>':'<p class="mut">View only – you do not have permission to edit.</p>')+'</div>';}
function pickLogo(inp){var f=inp.files[0];if(!f)return;var r=new FileReader();r.onload=function(e){var im=new Image();im.onload=function(){
  var s=Math.min(1,200/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.max(1,Math.round(im.width*s));c.height=Math.max(1,Math.round(im.height*s));c.getContext('2d').drawImage(im,0,0,c.width,c.height);
  var u=c.toDataURL('image/png');
  if(u.length>40000){var c2=document.createElement('canvas');c2.width=c.width;c2.height=c.height;var x=c2.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(c,0,0);u=c2.toDataURL('image/jpeg',.7);}
  if(u.length>44000){toast('Logo is too complex – choose a simpler image',1);return;}
  LOGO=u;gid('p_prev').innerHTML='<img src="'+u+'">';};im.onerror=function(){toast('Could not read this image',1);};im.src=e.target.result;};r.readAsDataURL(f);}
function rmLogo(){LOGO='';gid('p_prev').innerHTML='🏋️';}
async function saveProfile(){var d={};['GymName','OwnerName','Mobile','WhatsApp','Email','Address','City','State','Pin','GST','Website'].forEach(function(k){d[k]=gv('p_'+k);});
  if(!d.GymName){toast('Gym name is required',1);return;}
  var pl={section:'profile',data:d};if(LOGO!==undefined)pl.logo=LOGO;
  SET=await call('saveSettings',pl);brand();toast('Gym profile saved');draw();}

function tAtt(){var a=SET.attendance,ed=can('settings','edit'),d=!ed;
  $('#gmTab').innerHTML='<div class="card"><h3>✅ Attendance Settings</h3><div class="grid">'+
  F('a_CheckInEnabled','Enable Check-In',a.CheckInEnabled,{sel:YN,dis:d})+F('a_CheckOutEnabled','Enable Check-Out',a.CheckOutEnabled,{sel:YN,dis:d})+
  F('a_PreventDuplicate','Prevent Duplicate Check-In',a.PreventDuplicate,{sel:YN,dis:d})+F('a_AllowExpired','Allow Expired Member Attendance',a.AllowExpired,{sel:YN,dis:d})+
  F('a_StartTime','Attendance Start Time',a.StartTime,{t:'time',dis:d})+F('a_EndTime','Attendance Closing Time',a.EndTime,{t:'time',dis:d})+
  F('a_Method','Default Attendance Method',a.Method,{sel:['Member ID','Mobile Number','Search by Name'],dis:d})+'</div>'+
  '<p class="mut">Start / closing time apply to Check-In. “Allow Expired Member Attendance = No” also blocks marking Present for expired members on the Attendance list.</p>'+
  (ed?'<div class="gap end"><button class="btn" onclick="GM.saveAtt()">Save Attendance Settings</button></div>':'<p class="mut">View only – you do not have permission to edit.</p>')+'</div>';}
async function saveAtt(){var d={};['CheckInEnabled','CheckOutEnabled','PreventDuplicate','AllowExpired','StartTime','EndTime','Method'].forEach(function(k){d[k]=gv('a_'+k);});
  SET=await call('saveSettings',{section:'attendance',data:d});toast('Attendance settings saved');draw();}

async function tAccess(){var sa=isSA(),P=SET.perms,R=SET.roles,M=SET.modules;
  var h='<div class="card"><h3>🔐 Role Permissions</h3><p class="mut">None = hidden · View = can open and read · Edit = can add / change / delete. Super Admin always has full access.</p><div class="tw"><table><thead><tr><th>Module</th>'+R.map(function(r){return '<th>'+r+'</th>';}).join('')+'</tr></thead><tbody>'+
  M.map(function(m){return '<tr><td><b>'+ML[m]+'</b></td>'+R.map(function(r){return r==='Super Admin'?'<td><span class="b ok">Full access</span></td>':'<td><select class="gm-pm" data-r="'+r+'" data-m="'+m+'"'+(sa?'':' disabled')+'>'+['none','view','edit'].map(function(l){return '<option value="'+l+'"'+(P[r][m]===l?' selected':'')+'>'+l[0].toUpperCase()+l.slice(1)+'</option>';}).join('')+'</select></td>';}).join('')+'</tr>';}).join('')+
  '</tbody></table></div>'+(sa?'<div class="gap end"><button class="btn" onclick="GM.savePerms()">Save Permissions</button></div>':'<p class="mut">Only the Super Admin can modify permissions and staff accounts.</p>')+'</div><div id="gmUsers"></div>';
  $('#gmTab').innerHTML=h;
  if(sa){USERS=await call('getUsers');usersCard();}}
function usersCard(){gid('gmUsers').innerHTML='<div class="card"><div class="bar"><h3 style="margin:0">👥 Staff Users</h3><button class="btn sm" onclick="GM.userForm()">+ Add User</button></div><div class="tw">'+
  tbl([['User',function(u){return '<b>'+esc(u.FullName)+'</b><small>'+esc(u.Username)+'</small>';}],['Role',function(u){return esc(u.Role);}],['Status',function(u){return bd(u.Status);}],['',function(u){return '<span class="gap"><button class="btn sm g" onclick="GM.userForm(\''+esc(u.Username)+'\')">Edit</button><button class="btn sm r" onclick="GM.delUser(\''+esc(u.Username)+'\')">Delete</button></span>';}]],USERS)+'</div></div>';}
async function savePerms(){var o={};SET.roles.forEach(function(r){o[r]={};});document.querySelectorAll('.gm-pm').forEach(function(s){o[s.dataset.r][s.dataset.m]=s.value;});
  SET=await call('saveSettings',{section:'permissions',data:o});toast('Permissions saved');nav();draw();}
function userForm(un){var u=un?USERS.find(function(x){return x.Username===un;}):{Role:'Receptionist',Status:'Active'};
  modal('<h3>'+(un?'Edit':'Add')+' User</h3><div class="grid">'+F('u_name','Full Name',u.FullName||'',{r:1})+F('u_user','Username',u.Username||'',{r:1,dis:!!un,hint:'lowercase letters, numbers, . _ -'})+F('u_role','Role',u.Role,{sel:SET.roles})+F('u_status','Status',u.Status,{sel:['Active','Disabled']})+F('u_pw',un?'New Password (blank = keep)':'Password',"",{t:'password',r:!un,hint:'minimum 6 characters'})+'</div><div class="gap end"><button class="btn g" onclick="closeM()">Cancel</button><button class="btn" onclick="GM.saveUser(\''+(un||'')+'\')">Save User</button></div>');}
async function saveUser(un){var x={Username:gv('u_user'),FullName:gv('u_name'),Role:gv('u_role'),Status:gv('u_status'),Password:gid('u_pw').value};
  if(!x.FullName||!x.Username){toast('Name and username are required',1);return;}
  USERS=await call('saveUser',{mode:un?'edit':'new',user:x});closeM();usersCard();toast('User saved');}
function delUser(un){ask('Delete user <b>'+esc(un)+'</b>? They will no longer be able to login.',async function(){USERS=await call('deleteUser',{username:un});usersCard();toast('User deleted');});}

function tFin(){var f=SET.financial,sa=isSA(),d=!sa,y=+f.FYStartYear,fy=function(x){return 'April '+x+' – March '+(x+1);};
  $('#gmTab').innerHTML='<div class="card"><h3>💰 General Financial Configuration</h3><div class="grid">'+
  F('f_cur','Currency','INR (₹)',{sel:['INR (₹)'],dis:1})+F('f_fy','Financial Year',fy(y),{sel:[y-1,y,y+1].map(fy),dis:d})+
  F('f_rp','Receipt Number Prefix',f.ReceiptPrefix,{dis:d,hint:'Receipts show e.g. '+esc(f.ReceiptPrefix)+'00012'})+F('f_ip','Invoice Number Prefix',f.InvoicePrefix,{dis:d})+'</div>'+
  (sa?'<div class="gap end"><button class="btn" onclick="GM.saveFin()">Save Financial Settings</button></div>':'<p class="mut">Critical setting – only the Super Admin can modify.</p>')+'</div>';}
async function saveFin(){SET=await call('saveSettings',{section:'financial',data:{FYStartYear:parseInt(gv('f_fy').replace('April ','')),ReceiptPrefix:gv('f_rp'),InvoicePrefix:gv('f_ip')}});toast('Financial settings saved');draw();}

function tAcct(){$('#gmTab').innerHTML='<div class="card"><h3>👤 My Account</h3><p><b>'+esc(ME.FullName)+'</b> · '+esc(ME.Username)+' · '+bd(ME.Role)+'</p><div class="grid">'+
