<div id="app">
  <aside id="side"><div class="brand">🏋️ <b>Gym</b>Manager</div><nav id="nav"></nav></aside>
  <main><header><button id="burger" onclick="$('#side').classList.toggle('open')">☰</button><h1 id="title"></h1><span class="mut" id="dt"></span></header><div id="view"></div></main>
</div>
<div id="modalRoot"></div><div id="toast"></div><div id="loader"><i></i></div><div id="print"></div>

<script>
window.onerror=function(m,s,l,c){var d=document.createElement('div');d.style.cssText='position:fixed;top:0;left:0;right:0;z-index:999;background:#dc2626;color:#fff;padding:10px 14px;font:13px monospace';d.textContent='JS ERROR: '+m+' (line '+l+', col '+c+')';document.body.appendChild(d);};
</script>
<script>
/* ===== CONFIG ===== */
let GYM='FitZone Gym', CC='91'; /* gym name for receipts and WhatsApp, default country code for 10-digit numbers */
const CATS=['Rent','Electricity','Staff Salary','Equipment','Maintenance','Cleaning','Marketing','Other'], MODES=['Cash','UPI','Bank Transfer','Other'];
const NAV=[['dashboard','Dashboard','📊'],['members','Members','👥'],['plans','Plans','🏷️'],['payments','Fees & Payments','💳'],['attendance','Attendance','✅'],['renewals','Renewals','🔄'],['expenses','Expenses','🧾'],['reports','Reports','📈']];
const REP=[['collection_daily','Daily Collection'],['collection_weekly','Weekly Collection'],['collection_monthly','Monthly Collection'],['collection_yearly','Yearly Collection'],['memberpay','Member-wise Payments'],['outstanding','Outstanding Fees (Member-wise)'],['renewals','Membership Renewals'],['attendance','Attendance (Member-wise %)'],['attendance_log','Attendance Log'],['expense_list','Expense Report'],['expense_daily','Daily Expenses'],['expense_monthly','Monthly Expenses'],['expense_category','Category-wise Expenses'],['pnl','Profit & Loss']];
let DB={members:[],plans:[],payments:[],expenses:[],history:[],dash:{},today:''},page='dashboard',dirty=false,charts={},ATT=[],ATTD='',MC={},MF=[],PH='',PROF={},RPT={cols:[],rows:[],name:'report'};
const $=s=>document.querySelector(s),n=v=>Number(v)||0,money=v=>'₹'+n(v).toLocaleString('en-IN'),
esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),
mem=id=>DB.members.find(m=>m.MemberID===id)||{},iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'),
BC={Active:'ok',Paid:'ok',Present:'ok','Expiring Soon':'warn',Partial:'warn',Leave:'warn',Expired:'bad',Absent:'bad',Pending:'bad',Inactive:'mu',Advance:'in'},
bd=s=>`<span class="b ${BC[s]||'mu'}">${esc(s)}</span>`;
function addDur(s,d,u){const a=s.split('-').map(Number);let dt;if(u==='Months'){dt=new Date(a[0],a[1]-1+d,a[2]);if(dt.getDate()!==a[2])dt=new Date(a[0],a[1]+d,0);}else dt=new Date(a[0],a[1]-1,a[2]+d);return iso(dt);}
const daysLeft=m=>Math.round((Date.parse(m.ExpiryDate)-Date.parse(DB.today))/864e5);

/* ===== infrastructure ===== */
async function call(a,p,o={}){
  if(!o.quiet)$('#loader').style.display='flex';
  try{const r=await new Promise((ok,no)=>google.script.run.withSuccessHandler(ok).withFailureHandler(no).api(a,p||{}));
    const j=JSON.parse(r);if(!j.ok)throw new Error(j.error);if(j.data&&j.data.members)DB=j.data;return j.data;}
  catch(e){toast(e.message||String(e),1);throw e;}finally{$('#loader').style.display='none';}
}
function toast(m,e){const d=document.createElement('div');d.textContent=m;if(e)d.className='e';$('#toast').appendChild(d);setTimeout(()=>d.remove(),3500);}
function modal(h,wide){$('#modalRoot').innerHTML=`<div class="ov" onclick="if(event.target===this)closeM()"><div class="md ${wide?'wide':''}">${h}</div></div>`;}
const closeM=()=>$('#modalRoot').innerHTML='';
function ask(msg,fn){modal(`<h3>Please confirm</h3><p>${msg}</p><div class="gap end"><button class="btn g" onclick="closeM()">Cancel</button><button class="btn" style="background:var(--bad)" id="yes">Delete</button></div>`);$('#yes').onclick=async()=>{closeM();await fn();};}
function tbl(cols,rows){return `<table><thead><tr>${cols.map(c=>`<th>${c[0]}</th>`).join('')}</tr></thead><tbody>${rows.length?rows.map(r=>'<tr>'+cols.map(c=>`<td>${c[1](r)}</td>`).join('')+'</tr>').join(''):`<tr><td colspan="${cols.length}" class="mut" style="text-align:center;padding:28px">No records found</td></tr>`}</tbody></table>`;}
function fld(f,v){const val=v[f.k]==null?'':v[f.k],a=`id="f_${f.k}" ${f.ro?'readonly':''} ${f.h?`oninput="memCalc('${f.k}')" onchange="memCalc('${f.k}')"`:''}`;let i;
  if(f.t==='select')i=`<select ${a}>${f.o.map(o=>`<option ${o==val?'selected':''}>${esc(o)}</option>`).join('')}</select>`;
  else if(f.t==='textarea')i=`<textarea rows="2" ${a}>${esc(val)}</textarea>`;
  else i=`<input type="${f.t||'text'}" ${f.t==='number'?'step="any" min="0"':''} value="${esc(val)}" ${a}>`;
  return `<div class="${f.full?'full':''}"><label>${f.l}${f.r?' *':''}</label>${i}</div>`;}
function val(fs){const o={};for(const f of fs){if(f.ro)continue;const v=$('#f_'+f.k).value.trim();if(f.r&&!v){toast(f.l+' is required',1);return null;}o[f.k]=v;}return o;}
function doPrint(h){$('#print').innerHTML=h;setTimeout(()=>window.print(),120);}
const waBtn=(id,t,l='WhatsApp')=>`<button class="btn sm w" onclick="wa('${id}','${t}')">${l}</button>`;

/* ===== WhatsApp ===== */
const WA={
  expiry:m=>`Hello ${m.Name}, this is a reminder from ${GYM}. Your ${m.Plan} membership ${m.MStatus==='Expired'?'expired':'expires'} on ${m.ExpiryDate}. Please renew to continue your workouts. Thank you!`,
  pending:m=>`Hello ${m.Name}, a gentle reminder from ${GYM}: you have a pending fee balance of ${money(m.Pending)} for your ${m.Plan} membership. Kindly clear it at the earliest. Thank you!`,
  payment:(m,p)=>p?`Hello ${m.Name}, we received your payment of ${money(p.Received)} (${p.Mode}) on ${p.Date}. Receipt No: ${p.PaymentID}. Balance: ${money(p.Balance)}. Thank you! - ${GYM}`:`Hello ${m.Name}, thank you for your payment. - ${GYM}`,
  renewal:m=>`Hello ${m.Name}, your ${GYM} membership has been renewed. Plan: ${m.Plan}, valid ${m.StartDate} to ${m.ExpiryDate}. Stay fit! 💪`
};
function wa(id,type,pid){const m=mem(id),ps=DB.payments.filter(x=>x.MemberID===id),p=pid?DB.payments.find(x=>x.PaymentID===pid):ps[ps.length-1];
  let num=String(m.WhatsApp||m.Mobile||'').replace(/\D/g,'');if(num.length===10)num=CC+num;
  var SL=String.fromCharCode(47);window.open('https:'+SL+SL+'wa.me/'+num+'?text='+encodeURIComponent(WA[type](m,p)),'_blank');}
function waMenu(id){const m=mem(id);modal(`<h3>WhatsApp – ${esc(m.Name)}</h3><div class="grid">${[['expiry','Membership expiry reminder'],['pending','Pending fees reminder'],['payment','Payment confirmation'],['renewal','Renewal confirmation']].map(x=>`<button class="btn w" onclick="wa('${id}','${x[0]}')">${x[1]}</button>`).join('')}</div><div class="gap end"><button class="btn g" onclick="closeM()">Close</button></div>`);}

/* ===== navigation ===== */
const V={dashboard:vDash,members:vMembers,plans:vPlans,payments:vPay,attendance:vAtt,renewals:vRen,expenses:vExp,reports:vRep};
function go(p){page=p;document.querySelectorAll('#side a').forEach(a=>a.classList.toggle('on',a.dataset.p===p));$('#side').classList.remove('open');$('#title').textContent=NAV.find(x=>x[0]===p)[1];V[p]();window.scrollTo(0,0);}
async function refresh(){await call('bootstrap');V[page]();}

/* ===== dashboard ===== */
async function vDash(){
  if(dirty){dirty=false;await call('bootstrap');}
  const d=DB.dash,c=d.charts;
  const S=[['Total Members',d.total],['Active Members',d.active,'ok'],['Inactive Members',d.inactive],['Expired Memberships',d.expired,'bad'],['Expiring Soon (7 days)',d.expiring,'warn'],["Today's Attendance",d.attToday.Present+' present'],["Today's Collection",money(d.todayCollection),'ok'],['Month Collection',money(d.monthCollection),'ok'],['Pending Fees',money(d.pending),'bad'],['Monthly Expenses',money(d.monthExpenses),'warn'],['Monthly Profit',money(d.monthProfit),d.monthProfit>=0?'ok':'bad']];
  const L=(t,ids,fn)=>`<div class="card"><h3>${t} (${ids.length})</h3>${ids.slice(0,6).map(id=>{const m=mem(id);return `<div class="li"><span><b>${esc(m.Name)}</b><small>${fn(m)}</small></span><span class="gap">${waBtn(id,m.MStatus==='Expired'||m.MStatus==='Expiring Soon'?'expiry':'pending')}</span></div>`}).join('')||'<div class="mut">Nothing to show 🎉</div>'}${ids.length>6?`<div style="margin-top:8px"><a href="#" onclick="go('renewals');return false">View all →</a></div>`:''}</div>`;
  $('#view').innerHTML=`<div class="stats">${S.map(s=>`<div class="stat ${s[2]||''}"><small>${s[0]}</small><div>${s[1]}</div></div>`).join('')}</div>
  <div class="cols">${L('⏰ Expiring in 7 days',d.expiringList,m=>'Expires '+m.ExpiryDate+' · '+daysLeft(m)+' day(s) left')}${L('❌ Already expired',d.expiredList,m=>'Expired '+m.ExpiryDate)}${L('💰 Pending fees',d.pendingList,m=>'Pending '+money(m.Pending))}
  <div class="card"><h3>🆕 New members (7 days) (${d.newMembers.length})</h3>${d.newMembers.slice(0,6).map(id=>`<div class="li"><b>${esc(mem(id).Name)}</b><span class="mut">${mem(id).JoinDate}</span></div>`).join('')||'<div class="mut">No new members</div>'}</div>
  <div class="card"><h3>📅 Today's attendance</h3><div class="gap">${bd('Present')} ${d.attToday.Present} ${bd('Absent')} ${d.attToday.Absent} ${bd('Leave')} ${d.attToday.Leave}</div><div style="margin-top:12px"><button class="btn sm" onclick="go('attendance')">Mark attendance</button></div></div></div>
  <div class="cols" style="margin-top:16px"><div class="card"><h3>Monthly Revenue</h3><div class="ch"><canvas id="c1"></canvas></div></div><div class="card"><h3>Monthly Expenses</h3><div class="ch"><canvas id="c2"></canvas></div></div><div class="card"><h3>Member Growth</h3><div class="ch"><canvas id="c3"></canvas></div></div><div class="card"><h3>Plan Distribution</h3><div class="ch"><canvas id="c4"></canvas></div></div></div>`;
  const mk=(id,type,labels,ds,o)=>{if(charts[id])charts[id].destroy();charts[id]=new Chart($('#'+id),{type,data:{labels,datasets:ds},options:Object.assign({responsive:true,maintainAspectRatio:false,plugins:{legend:{display:type==='doughnut'}}},o||{})});};
