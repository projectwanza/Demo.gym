<script>
/* ===== ACP CLIENT LAYER (added) - notices, lock screen, feature switches, backup page ===== */
(function(){
var F={},BN=false,locked=false,inApp=false,DM='This feature has been disabled by your software provider. Please contact them to enable it.',BM='Adding new members has been blocked by your software provider. Please contact them.';
var IC={'Normal Notification':['ℹ️','#2563eb'],'Important Notice':['❗','#d97706'],'Subscription Expiry Warning':['⏳','#d97706'],'Payment Reminder':['💳','#d97706'],'Feature Disabled Notice':['🚫','#6b7280'],'Account Suspended Notice':['⛔','#dc2626'],'Custom Message':['📢','#2563eb']};
var st=document.createElement('style');st.textContent='#acpTop{position:fixed;top:0;left:0;right:0;z-index:310;padding:10px;display:grid;gap:8px}.acp-n{display:flex;gap:12px;align-items:flex-start;background:#fff;color:#111827;border-radius:12px;padding:12px 14px;border-left:5px solid var(--c);box-shadow:0 4px 18px #0002;margin-bottom:12px}#acpTop .acp-n{margin:0;max-width:760px;width:100%;justify-self:center}.acp-n i{font-style:normal;font-size:20px}.acp-n div{flex:1}.acp-n small{display:block;color:#6b7280;font-weight:600;margin-bottom:2px}.acp-n button{border:0;background:none;font-size:18px;cursor:pointer;color:#6b7280}#acpLock{position:fixed;inset:0;z-index:400;background:#0b1220;display:grid;place-items:center;padding:20px}#acpLock .box{background:#fff;color:#111827;max-width:460px;width:100%;border-radius:20px;padding:34px;text-align:center}#acpLock h2{margin:10px 0}#acpLock p{color:#4b5563;line-height:1.55}';document.head.appendChild(st);
var fs=document.createElement('style');document.head.appendChild(fs);
function e(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function html(N,top){return N.map(function(n){var s=IC[n.type]||IC['Custom Message'],x=n.type==='Normal Notification'||n.type==='Custom Message';return '<div class="acp-n" style="--c:'+s[1]+'"><i>'+s[0]+'</i><div><small>'+e(n.type)+'</small>'+e(n.text)+'</div>'+(x?'<button title="Dismiss" onclick="this.parentNode.remove()">×</button>':'')+'</div>';}).join('');}
function show(d){
  if(!d)return;
  if(d.blocked){lock(d.message);return;}
  if(locked){location.reload();return;}
  F=d.feats||{};BN=!!d.blockNew;
  var hide=[];if(F.reports===false)hide.push('#side a[data-p="reports"]');if(F.backup===false)hide.push('#side a[data-p="backup"]');fs.textContent=hide.length?hide.join(',')+'{display:none!important}':'';
  var top=document.getElementById('acpTop');if(!inApp){if(!top){top=document.createElement('div');top.id='acpTop';document.body.appendChild(top);}top.innerHTML=html(d.notices);return;}
  if(top)top.innerHTML='';
  var m=document.querySelector('main'),b=document.getElementById('acpBox');if(!b&&m){b=document.createElement('div');b.id='acpBox';m.insertBefore(b,m.firstChild);}if(b)b.innerHTML=html(d.notices);
}
function lock(msg){
  locked=true;var l=document.getElementById('acpLock');if(!l){l=document.createElement('div');l.id='acpLock';document.body.appendChild(l);}
  l.innerHTML='<div class="box"><div style="font-size:46px">⛔</div><h2>Access restricted</h2><p>'+e(msg)+'</p><button class="btn" onclick="location.reload()">Check again</button></div>';
}
function pub(){return new Promise(function(ok){google.script.run.withSuccessHandler(function(r){try{ok(JSON.parse(r).data)}catch(x){ok(null)}}).withFailureHandler(function(){ok(null)}).api('acpStatus',{});});}
function refresh(){(inApp?window.call('acpStatus',{},{quiet:1}):pub()).then(show).catch(function(){});}
setInterval(function(){var i=document.body.classList.contains('gm-in');if(i!==inApp){inApp=i;refresh();}},1500);
setInterval(refresh,180000);refresh();

/* any call rejected by the software provider re-checks status (shows lock screen when blocked) */
var _c=window.call;window.call=async function(a,p,o){try{return await _c(a,p,o);}catch(x){if(x&&/software provider/i.test(x.message||''))refresh();throw x;}};

/* hide / stop individual features in the UI (server enforces the same rules) */
function guard(o,name,kf,after){var f=o[name];if(typeof f!=='function')return;o[name]=function(){var k=kf.apply(null,arguments);
  if(k&&F[k]===false){toast(DM,1);return;}if(k==='memberAdd'&&BN){toast(BM,1);return;}
  var r=f.apply(this,arguments);if(after)after.apply(null,arguments);return r;};}
var logx=function(w){return function(){window.call('logExport',{what:w+' ('+(document.getElementById('rt')?document.getElementById('rt').value:'')+')'},{quiet:1}).catch(function(){});};};
[['memberForm',function(id){return id?'memberEdit':'memberAdd';}],['delMember',function(){return 'memberDelete';}],['viewMember',function(){return 'memberView';}],
 ['planForm',function(id){return id?'planEdit':'planAdd';}],['delPlan',function(){return 'planDelete';}],['payForm',function(){return 'paymentAdd';}],['renewForm',function(){return 'renew';}],
 ['expForm',function(id){return id?'expenseEdit':'expenseAdd';}],['delExp',function(){return 'expenseDelete';}],['runRep',function(){return 'reports';}],['mark',function(){return 'attMark';}]
].forEach(function(x){guard(window,x[0],x[1]);});
guard(window,'csv',function(){return 'export';},logx('CSV export'));guard(window,'printRep',function(){return 'export';},logx('Print report'));
var gt=setInterval(function(){if(!window.GM)return;clearInterval(gt);
 guard(GM,'userForm',function(u){return u?'staffEdit':'staffCreate';});guard(GM,'delUser',function(){return 'staffDelete';});guard(GM,'ci',function(k){return k==='in'?'checkIn':'checkOut';});
 guard(GM,'saveProfile',function(){return 'settingsProfile';});guard(GM,'saveAtt',function(){return 'settingsAttendance';});guard(GM,'saveFin',function(){return 'settingsFinancial';});guard(GM,'savePerms',function(){return 'settingsPerms';});guard(GM,'chgPw',function(){return 'changePw';});
},200);

/* ---- Backup page (Super Admin only; new feature) ---- */
NAV.push(['backup','Backup','💾']);
V.backup=async function(){
  $('#view').innerHTML='<div class="card"><h3>💾 Backup</h3><p class="mut">Creates a full copy of your gym database in your Google Drive folder “Gym Backups”.</p><button class="btn" id="bkGo">Create backup now</button></div><div class="card"><h3>Previous backups</h3><div id="bkList" class="tw">Loading…</div></div>';
  async function list(){var L=await window.call('listBackups',{},{quiet:1});document.getElementById('bkList').innerHTML=tbl([['Backup',function(x){return e(x.name);}],['Created',function(x){return x.created;}],['',function(x){return '<a class="btn sm g" target="_blank" href="'+e(x.url)+'">Open</a>';}]],L);}
  document.getElementById('bkGo').onclick=async function(){var b=this;b.disabled=true;try{var r=await window.call('backupNow',{});toast('Backup created: '+r.name);await list();}finally{b.disabled=false;}};
  try{await list();}catch(x){document.getElementById('bkList').textContent='Could not load backups.';}
};
})();
</script>
<script>
/* ===== SETTINGS: "Subscription" + "Support" tabs (added - nothing existing is changed) ===== */
(function(){
var ROLE,asked=0,TKL=[],
TYPES=['Complaint','Request','Feature Request','Technical Issue','Billing / Payment','Renewal Request','Other'],PRI=['Low','Normal','High','Urgent'],
SC={Open:'background:#fef3c7;color:#92400e','In Progress':'background:#dbeafe;color:#1e40af',Resolved:'background:#dcfce7;color:#166534',Closed:'background:#e5e7eb;color:#374151',Rejected:'background:#fee2e2;color:#991b1b'},
LC={Active:SC.Resolved,'Expiring Soon':SC.Open,'Not Set':SC.Closed,Expired:SC.Rejected,Suspended:SC.Rejected,Deactivated:SC.Rejected,Disabled:SC.Rejected,'Login Disabled':SC.Rejected},
PC={Paid:SC.Resolved,Pending:SC.Open,Unpaid:SC.Rejected};
function pill(s,c){return '<span class="b" style="'+(c||SC[s]||SC.Closed)+'">'+esc(s)+'</span>';}
function kv(l,v){return '<div><label>'+l+'</label><div style="font-weight:600">'+v+'</div></div>';}
function sel(id,list,v){return '<select id="'+id+'">'+list.map(function(x){return '<option'+(x===v?' selected':'')+'>'+esc(x)+'</option>';}).join('')+'</select>';}
function seenGet(){try{return JSON.parse(localStorage.getItem('gm_tk_seen')||'{}');}catch(e){return {};}}
function seenSet(o){try{localStorage.setItem('gm_tk_seen',JSON.stringify(o));}catch(e){}}
function unseen(t){var th=t.Thread||[],last=th[th.length-1];return !!last&&last.w!=='admin'&&th.length>(seenGet()[t.TicketID]||0);}
function lbl(){var b=document.querySelector('[data-xt="tk"]');if(!b)return;var c=TKL.filter(unseen).length;b.textContent='🛟 Support'+(c?' ('+c+' new)':'');}

/* ---- Subscription tab ---- */
async function vSub(t){
  t.innerHTML='<div class="card"><p class="mut">Loading…</p></div>';
  var r;try{r=await window.call('mySub',{},{quiet:1});}catch(e){t.innerHTML='<div class="card"><p class="mut">Could not load subscription details.</p></div>';return;}
  var s=r.sub,st=r.state,rem=st.remaining,remTxt=rem===null?'No expiry set':rem<0?'Expired '+(-rem)+' day(s) ago':rem+' day(s)';
  t.innerHTML='<div class="card"><h3>💳 My Subscription</h3><div class="gap" style="align-items:center;margin-bottom:12px">'+pill(st.label,LC[st.label])+'<span>Remaining: <b>'+esc(remTxt)+'</b></span></div>'+
  (st.message?'<p style="color:var(--bad);font-weight:500">'+esc(st.message)+'</p>':'')+
  '<div class="grid">'+kv('Plan',esc(s.Plan))+kv('Start date',esc(s.Start||'-'))+kv('Expiry date',esc(s.Expiry||'-'))+kv('Amount',money(s.Amount))+kv('Payment status',pill(s.PayStatus,PC[s.PayStatus]))+kv('Payment reference',esc(s.PayRef||'-'))+kv('Payment date',esc(s.PayDate||'-'))+kv('Account state',esc(s.Status))+'</div>'+
  ((rem!==null&&rem<=7)?'<div class="gap end"><button class="btn" onclick="XT.newTk(\'Renewal Request\')">Request renewal</button></div>':'<p class="mut" style="margin:14px 0 0">To renew or change your plan, raise a request from the Support tab.</p>')+'</div>'+
  '<div class="card"><h3>📜 Subscription History</h3><div class="tw">'+tbl([['Recorded',function(x){return esc(x.Time);}],['Action',function(x){return esc(x.Action);}],['Plan',function(x){return esc(x.Plan);}],['Start',function(x){return esc(x.StartDate||'-');}],['Expiry',function(x){return esc(x.ExpiryDate||'-');}],['Amount',function(x){return money(x.Amount);}],['Payment',function(x){return pill(x.PayStatus,PC[x.PayStatus])+(x.PayRef?'<small>'+esc(x.PayRef)+'</small>':'');}],['State',function(x){return esc(x.State);}]],r.history)+'</div></div>';
}

/* ---- Support tab ---- */
function listTk(){var b=$('#tk_list');if(!b)return;
  b.innerHTML=tbl([['ID',function(x){return esc(x.TicketID);}],['Date',function(x){return esc(String(x.CreatedAt).slice(0,16));}],['Type',function(x){return esc(x.Type);}],
  ['Subject',function(x){return '<b>'+esc(x.Subject)+'</b>'+(unseen(x)?' <span class="b" style="background:#dbeafe;color:#1e40af">New reply</span>':'');}],['Priority',function(x){return esc(x.Priority);}],['Status',function(x){return pill(x.Status);}],
  ['Last update',function(x){return esc(String(x.UpdatedAt).slice(0,16));}],['',function(x){return '<button class="btn sm g" onclick="XT.view(\''+esc(x.TicketID)+'\')">View</button>';}]],TKL);}
async function vTk(t,pre){
  t.innerHTML='<div class="card"><h3>🛟 New Request to Software Provider</h3><p class="mut" style="margin-top:-6px">Complaints, requests, feature ideas or any other issue – your software provider will reply here.</p><div class="grid">'+
  '<div><label>Type</label>'+sel('tk_type',TYPES,pre||'Request')+'</div><div><label>Priority</label>'+sel('tk_pri',PRI,'Normal')+'</div>'+
  '<div class="full"><label>Subject *</label><input id="tk_sub" maxlength="100"></div><div class="full"><label>Message * (max 800 characters)</label><textarea id="tk_msg" rows="4" maxlength="800"></textarea></div></div>'+
  '<div class="gap end"><button class="btn" onclick="XT.submit()">Send Request</button></div></div>'+
  '<div class="card"><h3>📋 My Requests</h3><div id="tk_list" class="tw"><span class="mut">Loading…</span></div></div>';
  try{TKL=await window.call('tkList',{},{quiet:1});}catch(e){var b=$('#tk_list');if(b)b.textContent='Could not load requests.';return;}
  listTk();lbl();}
async function submit(){
  var o={type:$('#tk_type').value,priority:$('#tk_pri').value,subject:$('#tk_sub').value.trim(),message:$('#tk_msg').value.trim()};
  if(!o.subject){toast('Enter a subject',1);return;}if(!o.message){toast('Write your message',1);return;}
  try{TKL=await window.call('tkNew',o);}catch(e){return;}
  toast('Request sent to your software provider');$('#tk_sub').value='';$('#tk_msg').value='';listTk();lbl();}
function view(id){
  var t=TKL.filter(function(x){return x.TicketID===id;})[0];if(!t)return;
  var th=t.Thread.map(function(m){
    if(m.w==='sys')return '<div class="mut" style="text-align:center;font-size:12px;margin:8px 0">'+esc(m.t)+' · '+esc(m.x)+'</div>';
    var me=m.w==='admin';
    return '<div style="display:flex;justify-content:'+(me?'flex-end':'flex-start')+';margin:8px 0"><div style="max-width:85%;padding:9px 12px;border-radius:12px;background:'+(me?'#fff1e6':'#eef2ff')+'"><div style="font-size:11px;color:var(--mut);margin-bottom:2px">'+esc(me?'You':m.n)+' · '+esc(m.t)+'</div><div style="white-space:pre-wrap">'+esc(m.x)+'</div></div></div>';}).join('');
  modal('<h3>'+esc(t.TicketID)+' · '+esc(t.Subject)+'</h3><p class="mut" style="margin:-6px 0 10px">'+esc(t.Type)+' · Priority: '+esc(t.Priority)+' · '+pill(t.Status)+'</p>'+
  '<div style="max-height:320px;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:4px 10px">'+th+'</div>'+
  (t.Status==='Closed'?'<p class="mut">This request is closed. Raise a new request if you need more help.</p><div class="gap end"><button class="btn g" onclick="closeM()">Close window</button></div>':
  '<div style="margin-top:12px"><label>Reply / follow-up</label><textarea id="tk_re" rows="3" maxlength="800"></textarea></div><div class="gap end"><button class="btn g" onclick="closeM()">Close window</button><button class="btn r" onclick="XT.closeTk(\''+esc(id)+'\')">Mark as closed</button><button class="btn" onclick="XT.reply(\''+esc(id)+'\')">Send reply</button></div>'),true);
  var s=seenGet();s[id]=t.Thread.length;seenSet(s);listTk();lbl();}
async function reply(id){
  var x=$('#tk_re').value.trim();if(!x){toast('Write your reply',1);return;}
  try{TKL=await window.call('tkReply',{id:id,text:x});}catch(e){return;}
  toast('Reply sent');view(id);}
async function closeTk(id){
  try{TKL=await window.call('tkClose',{id:id});}catch(e){return;}
  toast('Request closed');view(id);}

/* ---- tab plumbing: adds two buttons to the existing Settings tab bar, Super Admin only ---- */
function open(w,pre){
  var bar=document.querySelector('#view .gm-tabs'),tab=$('#gmTab');if(!bar||!tab)return;
  bar.querySelectorAll('button').forEach(function(b){b.classList.remove('on');});
  var b=bar.querySelector('[data-xt="'+w+'"]');if(b)b.classList.add('on');
  if(w==='sub')vSub(tab);else vTk(tab,pre);}
function inject(){
  var v=$('#view');if(!v)return;var bar=v.querySelector('.gm-tabs');if(!bar||bar.querySelector('[data-xt]'))return;
  if(ROLE===undefined){if(!asked){asked=1;window.call('authInfo',{},{quiet:1}).then(function(r){ROLE=(r&&r.user&&r.user.Role)||'';inject();}).catch(function(){asked=0;});}return;}
  if(ROLE!=='Super Admin')return;
  bar.insertAdjacentHTML('beforeend','<button data-xt="sub" onclick="XT.open(\'sub\')">💳 Subscription</button><button data-xt="tk" onclick="XT.open(\'tk\')">🛟 Support</button>');
  window.call('tkList',{},{quiet:1}).then(function(l){TKL=l;lbl();}).catch(function(){});}
window.XT={open:open,newTk:function(ty){open('tk',ty);},submit:submit,view:view,reply:reply,closeTk:closeTk};
var mo=new MutationObserver(function(){inject();});
(function arm(){var v=$('#view');if(v)mo.observe(v,{childList:true});else setTimeout(arm,500);})();
})();
</script>
