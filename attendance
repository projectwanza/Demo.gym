<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gym Attendance</title>
<meta name="theme-color" content="#0b1220">
<meta name="apple-mobile-web-app-capable" content="yes">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--bg:#0b1220;--ink:#111827;--mut:#6b7280;--line:#e5e7eb;--acc:#f97316;--acc2:#fb923c;--ok:#16a34a;--warn:#d97706;--bad:#dc2626}
html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink)}
body{min-height:100dvh;background:radial-gradient(900px 420px at 50% -120px,rgba(249,115,22,.35),transparent 70%),linear-gradient(180deg,#0b1220,#111827 60%,#0b1220);padding-top:env(safe-area-inset-top)}
.app{max-width:460px;margin:0 auto;min-height:100dvh;display:flex;flex-direction:column}
.hero{text-align:center;color:#fff;padding:28px 24px 22px;transition:padding .25s}
.logo{width:84px;height:84px;border-radius:24px;margin:0 auto 14px;background:linear-gradient(135deg,var(--acc),#ea580c);display:flex;align-items:center;justify-content:center;font-size:40px;box-shadow:0 12px 30px rgba(249,115,22,.4);overflow:hidden}
.logo img{width:100%;height:100%;object-fit:cover;background:#fff}
.hero h1{font-size:25px;line-height:1.2;margin:0;font-weight:800;letter-spacing:-.3px}
.hero h1 b{color:var(--acc2)}
.hero p{margin:6px 0 0;color:#9ca3af;font-size:14px}
body:not([data-s="s1"]) .hero{padding:16px 24px 14px}
body:not([data-s="s1"]) .logo{width:52px;height:52px;border-radius:16px;font-size:24px;margin-bottom:8px}
body:not([data-s="s1"]) .hero h1{font-size:18px}
body:not([data-s="s1"]) .hero p{display:none}
.sheet{flex:1;background:#fff;border-radius:28px 28px 0 0;padding:22px 20px calc(28px + env(safe-area-inset-bottom));box-shadow:0 -10px 40px rgba(0,0,0,.25)}
.steps{display:flex;gap:6px;justify-content:center;margin:0 0 20px}
.steps i{height:5px;width:34px;border-radius:5px;background:var(--line);transition:.3s}
.steps i.on{background:var(--acc)}
.scr{display:none;animation:up .3s ease}
.scr.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
h2{font-size:20px;margin:0 0 4px;font-weight:800;text-align:center}
.lead{color:var(--mut);font-size:14px;text-align:center;margin:0 0 20px}
label{display:block;font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--mut);margin:0 0 8px}
input{width:100%;height:58px;border:2px solid var(--line);border-radius:16px;padding:0 18px;font:700 20px Inter,sans-serif;letter-spacing:1px;text-transform:uppercase;color:var(--ink);outline:none;transition:.2s;background:#f9fafb}
input::placeholder{color:#c4c9d2;font-weight:600;letter-spacing:.5px}
input:focus{border-color:var(--acc);background:#fff;box-shadow:0 0 0 4px rgba(249,115,22,.15)}
.btn{width:100%;min-height:56px;border:0;border-radius:16px;font:800 16px Inter,sans-serif;letter-spacing:.6px;color:#fff;background:linear-gradient(135deg,var(--acc),#ea580c);box-shadow:0 8px 20px rgba(249,115,22,.35);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;margin-top:14px;transition:transform .1s}
.btn:active{transform:scale(.98)}
.btn[disabled]{opacity:.65;pointer-events:none}
.btn.ghost{background:#fff;color:var(--ink);border:2px solid var(--line);box-shadow:none}
.btn.ok{background:linear-gradient(135deg,#22c55e,#15803d);box-shadow:0 8px 20px rgba(22,163,74,.35)}
.link{background:none;border:0;color:var(--mut);font:600 14px Inter,sans-serif;padding:14px;width:100%;cursor:pointer}
.spin{width:18px;height:18px;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.msg{display:none;margin:14px 0 0;padding:12px 14px;border-radius:14px;font-size:14px;font-weight:600;line-height:1.4}
.msg.on{display:block}
.msg.bad{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
.msg.warn{background:#fffbeb;color:#92400e;border:1px solid #fde68a}
.hint{font-size:12px;color:var(--mut);text-align:center;margin:18px 0 0;line-height:1.5}
.card{border:1px solid var(--line);border-radius:20px;padding:16px;background:linear-gradient(180deg,#fff,#f9fafb);margin-bottom:6px}
.who{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.av{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--acc),#ea580c);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:19px;flex:none}
.who b{display:block;font-size:18px;line-height:1.2}
.who small{color:var(--mut);font-size:13px;font-weight:600}
.chip{margin-left:auto;font-size:11px;font-weight:800;letter-spacing:.4px;padding:6px 10px;border-radius:99px;white-space:nowrap}
.c-Active{background:#dcfce7;color:#166534}.c-ExpiringSoon{background:#fef3c7;color:#92400e}.c-Expired{background:#fee2e2;color:#991b1b}.c-Inactive{background:#e5e7eb;color:#374151}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cell{background:#f3f4f6;border-radius:14px;padding:11px 12px}
.cell small{display:block;font-size:11px;font-weight:700;color:var(--mut);letter-spacing:.4px;text-transform:uppercase}
.cell b{display:block;font-size:15px;margin-top:3px}
.cell em{font-style:normal;font-size:12px;font-weight:600;color:var(--mut)}
.cell.due b{color:var(--bad)}.cell.clear b{color:var(--ok)}
.camwrap{position:relative;width:100%;max-width:340px;aspect-ratio:1/1;margin:16px auto 0;border-radius:28px;overflow:hidden;background:#0b1220;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.camwrap video,.camwrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
.ring{position:absolute;inset:14% 18%;border:3px dashed rgba(255,255,255,.7);border-radius:50%;pointer-events:none}
.camtxt{position:absolute;left:0;right:0;bottom:12px;text-align:center;color:#fff;font-size:12px;font-weight:600;text-shadow:0 1px 4px #000}
.shutter{width:76px;height:76px;border-radius:50%;border:5px solid var(--acc);background:#fff;margin:16px auto 0;display:block;box-shadow:0 6px 18px rgba(249,115,22,.4);cursor:pointer}
.shutter:active{transform:scale(.92)}
.center{text-align:center}
.big{width:104px;height:104px;border-radius:50%;margin:6px auto 18px;display:flex;align-items:center;justify-content:center}
.big.g{background:#dcfce7}.big.a{background:#fef3c7}
.big svg{width:56px;height:56px}
.pop{animation:pop .5s cubic-bezier(.2,1.6,.4,1)}
@keyframes pop{from{transform:scale(.2);opacity:0}to{transform:none;opacity:1}}
.alr{font-size:24px;line-height:1.25;font-weight:800;color:#b45309;margin:0 0 8px}
.okh{font-size:25px;font-weight:800;color:#15803d;margin:0 0 4px}
.nm{font-size:19px;font-weight:700;margin:6px 0 2px}
.sub{color:var(--mut);font-size:14px;font-weight:500;margin:0}
.tm{display:inline-block;margin-top:16px;background:#f3f4f6;border-radius:99px;padding:9px 18px;font-weight:700;font-size:15px}
.sel{width:92px;height:92px;border-radius:50%;object-fit:cover;border:4px solid #fff;box-shadow:0 6px 18px rgba(0,0,0,.2);margin:0 auto 10px;display:block;transform:scaleX(-1)}
[hidden]{display:none!important}
</style>
</head>
<body data-s="s1">
<div class="app">
  <header class="hero">
    <div class="logo" id="logo">🏋️</div>
    <h1 id="gymH">Welcome to <b>our Gym</b></h1>
    <p>Member Self Attendance</p>
  </header>

  <main class="sheet">
    <div class="steps"><i id="p1" class="on"></i><i id="p2"></i><i id="p3"></i></div>

    <!-- SCREEN 1 : MEMBER ID -->
    <section class="scr on" id="s1">
      <h2>Enter Your Member ID</h2>
      <p class="lead">Your ID is printed on your membership card</p>
      <label for="mid">Member ID</label>
      <input id="mid" type="text" placeholder="e.g. GYM-0001" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" enterkeyhint="go" maxlength="20">
      <div class="msg bad" id="e1"></div>
      <button class="btn" id="vb">VERIFY MEMBER</button>
      <p class="hint">🔒 Your details are shown only after your ID is verified.</p>
    </section>

    <!-- SCREEN 2 : DETAILS + SELFIE -->
    <section class="scr" id="s2">
      <div class="card">
        <div class="who"><div class="av" id="av">M</div><div><b id="nm">—</b><small id="idl">—</small></div><span class="chip" id="chip">—</span></div>
        <div class="grid">
          <div class="cell"><small>Plan</small><b id="plan">—</b></div>
          <div class="cell"><small>Expiry Date</small><b id="exp">—</b><em id="left"></em></div>
          <div class="cell" id="dueBox" style="grid-column:1/3"><small>Pending Payment</small><b id="due">—</b></div>
        </div>
      </div>
      <div class="msg warn" id="blk"></div>

      <div id="camBox">
        <div id="live">
          <h2 style="margin-top:18px">Take Your Selfie</h2>
          <p class="lead" style="margin-bottom:0">Look at the camera and keep your face inside the circle</p>
          <div class="camwrap"><video id="vid" playsinline muted autoplay></video><div class="ring"></div><div class="camtxt" id="camtxt">Opening camera…</div></div>
          <button class="shutter" id="snap" aria-label="Capture photo" hidden></button>
          <div class="msg bad" id="ce"></div>
          <button class="btn ghost" id="retryCam" hidden>TRY CAMERA AGAIN</button>
        </div>
        <div id="rev" hidden>
          <h2 style="margin-top:18px">Looking good!</h2>
          <p class="lead" style="margin-bottom:0">Happy with this photo?</p>
          <div class="camwrap"><img id="shot" alt="Your selfie"></div>
          <div class="msg bad" id="e2"></div>
          <button class="btn ok" id="mk">MARK MY ATTENDANCE</button>
          <button class="btn ghost" id="rt" style="margin-top:10px">RETAKE PHOTO</button>
        </div>
      </div>
      <button class="link" id="back1">Not you? Use a different Member ID</button>
    </section>

    <!-- SCREEN 3 : SUCCESS -->
    <section class="scr center" id="s3">
      <img class="sel" id="selOk" alt="">
      <div class="big g pop"><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
      <p class="okh">Attendance Marked!</p>
      <p class="nm" id="okNm"></p>
      <p class="sub" id="okDt"></p>
      <div class="tm" id="okTm"></div>
      <p class="sub" style="margin-top:18px">Have a great workout 💪</p>
      <button class="btn" id="done">DONE</button>
    </section>

    <!-- SCREEN 4 : ALREADY PRESENT -->
    <section class="scr center" id="s4">
      <div class="big a pop"><svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/></svg></div>
      <p class="alr">YOU ARE ALREADY PRESENT FOR TODAY!</p>
      <p class="nm" id="alNm"></p>
      <p class="sub" id="alSub"></p>
      <div class="tm" id="alTm" hidden></div>
      <button class="btn" id="done2">OK</button>
    </section>
  </main>
</div>

<script>
/* ===== set this to the SAME web-app URL used in Admin.html (window.GAS_URL) ===== */
var GAS_URL = 'https://script.google.com/macros/s/AKfycbw9h7vyzRqL5lYnV3pPYeajvwiUod7s7Xd-PMDY6ZWJZGbgFMi5odBVYKobA7GqqVc1zg/exec';

var $ = function (i) { return document.getElementById(i); };
var M = null, photo = '', stream = null, resetT = null, MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function dev() { try { var d = localStorage.getItem('gs_dev'); if (!d) { d = Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem('gs_dev', d); } return d; } catch (e) { return 'nodev'; } }
function call(a, p) {
  p = p || {}; p.dev = dev();
  return fetch(GAS_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ a: a, p: p }), redirect: 'follow' })
    .then(function (r) { return r.text(); }, function () { throw new Error('No internet connection. Please check your network and try again.'); })
    .then(function (t) { var j; try { j = JSON.parse(t); } catch (e) { throw new Error('Server is not reachable right now. Please try again.'); } if (!j.ok) throw new Error(j.error || 'Something went wrong'); return j.data; });
}
function show(id) {
  ['s1', 's2', 's3', 's4'].forEach(function (s) { $(s).classList.toggle('on', s === id); });
  document.body.setAttribute('data-s', id);
  var st = id === 's1' ? 1 : id === 's2' ? 2 : 3;
  [1, 2, 3].forEach(function (i) { $('p' + i).classList.toggle('on', i <= st); });
  window.scrollTo(0, 0);
}
function msg(id, t) { var e = $(id); e.textContent = t || ''; e.classList.toggle('on', !!t); }
function busy(id, on, label) { var b = $(id); if (on) { b._t = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="spin"></span>' + label; } else { b.disabled = false; if (b._t) b.innerHTML = b._t; } }
function fDate(s) { var a = String(s || '').split('-'); return a.length === 3 ? parseInt(a[2], 10) + ' ' + MON[+a[1] - 1] + ' ' + a[0] : (s || '—'); }
function fTime(s) { var a = String(s || '').split(':'); if (a.length < 2) return ''; var h = +a[0]; return ((h % 12) || 12) + ':' + a[1] + ' ' + (h >= 12 ? 'PM' : 'AM'); }
function fMoney(v) { return '₹' + Number(v || 0).toLocaleString('en-IN'); }

/* ---------- gym name + logo (no member data) ---------- */
call('selfInfo').then(function (d) {
  if (d.gym) { $('gymH').innerHTML = 'Welcome to <b></b>'; $('gymH').querySelector('b').textContent = d.gym; document.title = d.gym + ' – Attendance'; }
  if (d.logo && /^data:image\//.test(d.logo)) { var i = new Image(); i.alt = 'Gym logo'; i.src = d.logo; $('logo').innerHTML = ''; $('logo').appendChild(i); }
}).catch(function () {});

/* ---------- step 1: verify ---------- */
function verify() {
  var v = $('mid').value.trim(); msg('e1', '');
  if (!v) { msg('e1', 'Please enter your Member ID'); $('mid').focus(); return; }
  busy('vb', true, 'VERIFYING…');
  call('selfVerify', { memberId: v }).then(function (d) { busy('vb', false); M = d; render(d); })
    .catch(function (e) { busy('vb', false); msg('e1', e.message); });
}
function render(d) {
  if (d.already) {
    $('alNm').textContent = d.name; $('alSub').textContent = 'Your attendance is already recorded for today.';
    $('alTm').hidden = !d.checkIn; if (d.checkIn) $('alTm').textContent = 'Checked in at ' + fTime(d.checkIn);
    show('s4'); return;
  }
  $('av').textContent = (d.name || 'M').trim().charAt(0).toUpperCase(); $('nm').textContent = d.name; $('idl').textContent = d.id;
  var ch = $('chip'); ch.textContent = d.status.toUpperCase(); ch.className = 'chip c-' + d.status.replace(/\s/g, '');
  $('plan').textContent = d.plan || '—'; $('exp').textContent = d.expiry ? fDate(d.expiry) : '—';
  $('left').textContent = d.daysLeft === null ? '' : d.daysLeft < 0 ? 'Expired ' + Math.abs(d.daysLeft) + ' day(s) ago' : d.daysLeft === 0 ? 'Expires today' : d.daysLeft + ' day(s) left';
  $('due').textContent = d.pending > 0 ? fMoney(d.pending) : 'No dues ✓'; $('dueBox').className = 'cell ' + (d.pending > 0 ? 'due' : 'clear');
  msg('blk', d.canMark ? '' : d.reason); $('camBox').hidden = !d.canMark;
  show('s2');
  if (d.canMark) { setLive(); startCam(); }
}

/* ---------- step 2: live front camera ---------- */
function setLive() { photo = ''; $('live').hidden = false; $('rev').hidden = true; msg('e2', ''); }
function camErr(t) { $('camtxt').textContent = ''; $('snap').hidden = true; msg('ce', t); $('retryCam').hidden = false; }
function startCam() {
  stopCam(); msg('ce', ''); $('retryCam').hidden = true; $('snap').hidden = true; $('camtxt').textContent = 'Opening camera…';
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { camErr('Camera is not available. Please open this page in Chrome (Android) or Safari (iPhone) using the https link.'); return; }
  navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 720 } }, audio: false }).then(function (s) {
    stream = s; var v = $('vid'); v.srcObject = s; var p = v.play(); if (p && p.catch) p.catch(function () {});
    v.onloadedmetadata = function () { $('snap').hidden = false; $('camtxt').textContent = 'Tap the button to capture'; };
  }).catch(function (e) {
    var n = e && e.name;
    camErr(n === 'NotAllowedError' || n === 'SecurityError' ? 'Camera permission is blocked. Please allow camera access for this page in your browser settings, then tap "Try camera again".' : n === 'NotFoundError' ? 'No camera found on this device.' : 'Could not start the camera. Close other apps that use the camera and try again.');
  });
}
function stopCam() { if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; } $('vid').srcObject = null; }
function snap() {
  var v = $('vid'); if (!v.videoWidth) return;
  var s = Math.min(v.videoWidth, v.videoHeight), sx = (v.videoWidth - s) / 2, sy = (v.videoHeight - s) / 2, size = 320, q = .6, d, c = document.createElement('canvas');
  do { c.width = c.height = size; c.getContext('2d').drawImage(v, sx, sy, s, s, 0, 0, size, size); d = c.toDataURL('image/jpeg', q); size -= 40; q = Math.max(.4, q - .05); } while (d.length > 40000 && size >= 160);
  photo = d; $('shot').src = d; stopCam(); $('live').hidden = true; $('rev').hidden = false; msg('e2', '');
}

/* ---------- step 3: mark attendance ---------- */
function mark() {
  if (!photo) { msg('e2', 'Please capture your live photo first'); return; }
  msg('e2', ''); busy('mk', true, 'MARKING…');
  call('selfMark', { memberId: M.id, selfie: photo }).then(function (d) {
    busy('mk', false);
    if (d.already) { M.checkIn = d.time; M.name = d.name; render(Object.assign({}, M, { already: true })); return; }
    $('selOk').src = photo; $('okNm').textContent = d.name; $('okDt').textContent = fDate(d.date); $('okTm').textContent = 'Checked in at ' + fTime(d.time);
    show('s3'); resetT = setTimeout(reset, 12000);
  }).catch(function (e) { busy('mk', false); msg('e2', e.message); });
}
function reset() { clearTimeout(resetT); stopCam(); M = null; photo = ''; $('mid').value = ''; msg('e1', ''); msg('blk', ''); setLive(); show('s1'); }

$('vb').onclick = verify;
$('mid').addEventListener('keydown', function (e) { if (e.key === 'Enter') verify(); });
$('snap').onclick = snap; $('mk').onclick = mark; $('rt').onclick = function () { setLive(); startCam(); };
$('retryCam').onclick = startCam; $('back1').onclick = reset; $('done').onclick = reset; $('done2').onclick = reset;
document.addEventListener('visibilitychange', function () { if (document.hidden) stopCam(); else if (document.body.getAttribute('data-s') === 's2' && M && M.canMark && !$('live').hidden && !stream) startCam(); });
window.addEventListener('pagehide', stopCam);
</script>
</body>
</html>
